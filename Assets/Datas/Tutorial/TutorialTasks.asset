    goal: 7
    amount: 1
    slot: 1
    equips: []
  - template: "{LeftAbility} でアビリティを使い、的に当てる\n使うと溜まるまで使えない"
    goal: 6
    amount: 1
    slot: 2
    equips:
    - slot: 2

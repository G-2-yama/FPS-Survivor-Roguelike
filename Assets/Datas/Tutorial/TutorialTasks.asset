    amount: 3
    slot: 0
    equips: []
  - template: "{Crouch} でスライディング"
    goal: 4
    amount: 3
    slot: 0
    equips: []
  - template: "ジャンプして、空中で {Crouch}
      で急降下"
    goal: 5
    amount: 1
    slot: 0
    equips: []
  - template: "{LeftFire} で左手の武器を撃ち、的に当てる"
    goal: 6
    amount: 5
    slot: 0
